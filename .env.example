# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=your_api_key_here
LLM_TIMEOUT=120.0
LLM_MAX_RETRIES=2

# ── Sandbox ───────────────────────────────────────────────────────────────────
SANDBOX_MEM_LIMIT=256m
SANDBOX_NANO_CPUS=500000000
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_CONTAINERS=12
SANDBOX_MAX_CONCURRENT_EXECS=0
SANDBOX_IDLE_TTL_SECONDS=300.0
SANDBOX_EXEC_TIMEOUT=30.0
SANDBOX_SESSIONS_ROOT=data/sandbox-sessions
SANDBOX_NETWORK_DISABLED=true
SANDBOX_TMPFS_TMP_SIZE=32m

# ── Quota (0 = unlimited) ─────────────────────────────────────────────────────
QUOTA_MAX_RUNS=0
QUOTA_MAX_TOOL_CALLS=0
QUOTA_MAX_TOKENS_IN=0
QUOTA_MAX_TOKENS_OUT=0
QUOTA_WINDOW_SECONDS=60.0

# ── App ───────────────────────────────────────────────────────────────────────
APPROVAL_TIMEOUT_SECONDS=300.0

# ── Observability ─────────────────────────────────────────────────────────────
AGENTENGINE_LOG_DIR=logs

# ── Misc ──────────────────────────────────────────────────────────────────────
RUN_INTEGRATION=0
PYTHONIOENCODING=utf-8
TAVILY_API_KEY=your_tavily_api_key_here
